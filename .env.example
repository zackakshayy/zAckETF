# ====================================================================
# project_alpha — environment variables (TEMPLATE)
# ====================================================================
# Copy this file to `.env` (which is gitignored) and fill in real keys:
#
#   cp .env.example .env
#   # then edit .env with your real values
#
# Load into your shell with:   source .env   (after `set -a`)
# Or use python-dotenv in scripts.
# ====================================================================

# Alpha Vantage — required only for scripts/fetch_alpha_vantage_eod.py
# Free tier: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_key_here

# EODHD — required if you want to refresh fundamentals/news from the API
# Get a key at: https://eodhd.com/
EODHD_API_KEY=your_key_here

# FRED — for refreshing macro series (VIX, T10Y2Y, FEDFUNDS, etc.)
# Get a key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here

# Optional — override config file location
# ALPHA_CONFIG=/absolute/path/to/alpha.yaml

# Optional — base path for master data (overrides config paths if set)
# DATA_ROOT=/absolute/path/to/ProjectX_MasterData
